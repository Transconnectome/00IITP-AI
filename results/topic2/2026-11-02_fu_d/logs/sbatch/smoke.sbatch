#!/bin/bash
#SBATCH --job-name=fud-smoke
#SBATCH --partition=debug
#SBATCH --nodelist=b300-01
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=00:20:00
#SBATCH --output=/scratch/iitp4/fu_d/slurm/%x-%j.out
# worker_FU_D_r1, run tw-20261031-four-topics, Topic 2 follow-up D (E192).  Generated by scripts/topic2fu_d_slurm.py.
set -u
echo "job=$SLURM_JOB_ID node=$(hostname -s) gpus=${CUDA_VISIBLE_DEVICES:-} start=$(date -u +%FT%TZ)"
nvidia-smi --query-gpu=index,memory.used,utilization.gpu --format=csv,noheader
cd /scratch/iitp4/fu_d/code
PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 /scratch/iitp4/fu_d/venv/bin/python -B scripts/topic2fu_d_equiv.py --ckpt /scratch/iitp4/worker_M3_r1/runs/hcp_E_s0/model_final.pt --expected-json /scratch/iitp4/fu_d/code/results/topic2/2026-11-01/runs/hcp_E_s0/run.json --base /scratch/iitp4/fu_d --out /scratch/iitp4/fu_d/smoke/equiv.json
PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=4 /scratch/iitp4/fu_d/venv/bin/python -B scripts/topic2fu_d_train.py --source hcp --arm C --seed 0 --out /scratch/iitp4/fu_d/smoke/smoke_hcp_C_s0 --base /scratch/iitp4/fu_d --smoke-abort; true
rc=$?
echo "rc=$rc end=$(date -u +%FT%TZ)"
exit $rc
